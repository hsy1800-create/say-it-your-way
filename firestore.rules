rules_version = '2';

// 학생: 익명 로그인. 자기 기록, 자기에게 온 카드, 선생님이 공유한 문장 벽, 선생님이 알려준 말만 본다.
// 선생님: 구글 로그인. 자기 반의 모든 것을 보고 고친다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacherAccount() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function classDoc(code) { return get(/databases/$(database)/documents/classes/$(code)); }
    function isTeacher(code) { return signedIn() && classDoc(code).data.teacherUid == request.auth.uid; }
    function isMember(code) { return signedIn() && exists(/databases/$(database)/documents/classes/$(code)/students/$(request.auth.uid)); }
    function owns(data) { return signedIn() && data.uid == request.auth.uid; }

    match /classes/{code} {
      allow read: if signedIn();
      allow create: if isTeacherAccount() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isTeacher(code) && request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if isTeacher(code);

      match /students/{sid} {
        allow read: if sid == request.auth.uid || isTeacher(code);
        allow create, update: if signedIn() && sid == request.auth.uid
          && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 20;
        allow delete: if isTeacher(code);
      }

      match /entries/{id} {
        allow read: if isTeacher(code) || owns(resource.data) || (isMember(code) && resource.data.shared == true);
        allow create: if isMember(code) && owns(request.resource.data)
          && request.resource.data.get('shared', false) == false
          && request.resource.data.get('en', '').size() <= 400
          && request.resource.data.get('ko', '').size() <= 400;
        allow update: if isTeacher(code)
          || (owns(resource.data) && owns(request.resource.data)
              && request.resource.data.get('shared', false) == resource.data.get('shared', false)
              && request.resource.data.get('en', '').size() <= 400
              && request.resource.data.get('ko', '').size() <= 400);
        allow delete: if isTeacher(code);
      }

      match /searches/{id} {
        allow read, delete: if isTeacher(code);
        allow create: if isMember(code) && owns(request.resource.data) && request.resource.data.q.size() <= 100;
      }

      match /notices/{id} {
        allow read: if isMember(code) || isTeacher(code);
        allow create, update, delete: if isTeacher(code);
      }

      match /tips/{id} {
        allow read: if isTeacher(code) || owns(resource.data);
        allow create, update, delete: if isTeacher(code);
      }

      match /photos/{id} {
        allow read: if isTeacher(code) || owns(resource.data);
        allow create, update: if isMember(code) && owns(request.resource.data)
          && request.resource.data.dataUrl.size() < 900000;
        allow delete: if isTeacher(code);
      }
    }
  }
}
